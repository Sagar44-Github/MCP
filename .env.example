# URL used by the dashboard's MCP client to call Sentinel's Streamable HTTP gateway.
# Keep this in sync with Uvicorn's host and port when they differ from the README defaults.
MCP_SENTINEL_GATEWAY_URL=http://127.0.0.1:8000/mcp
# Optional local demo approval credential (replace with a private value before use).
# MCP_SENTINEL_APPROVER_TOKEN=replace-this-with-a-private-token
# MCP_SENTINEL_APPROVER_ID=local-reviewer
# Optional ElevenLabs TTS configuration. Set these in the backend environment.
# ELEVENLABS_API_KEY=replace-with-your-elevenlabs-key
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
